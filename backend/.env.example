# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crm_db
DB_USER=root
DB_PASSWORD=
DB_SYNC=false

# Auth
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AI provider (Groq)
GROQ_API_KEY=
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-20b
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=2
# AI_TOOLS_ENABLED=true

# Email (for OTP / password reset, Phase 2)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
